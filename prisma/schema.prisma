generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MANAGER
  KITCHEN
}

enum FulfillmentCategory {
  PIZZA
  PASTA
  OTHER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  REJECTED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum OrderPaymentStatus {
  PENDING
  PAID
  CREDITED
  FAILED
  REFUND_REQUIRED
  REFUNDED
}

enum ExtraSelectionMode {
  MULTIPLE
  SINGLE
}

enum PromotionKind {
  AUTOMATIC
  CODE
}

enum PromotionDiscountType {
  PERCENT
  FIXED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(320)
  name          String?   @db.VarChar(160)
  phone         String?   @db.VarChar(40)
  emailVerified DateTime?
  role          UserRole  @default(CUSTOMER)
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  sessions      Session[]
  managerAccessTokens ManagerAccessToken[]
  customerCredential CustomerCredential?
  testOrders TestOrder[]
  customerEmailTokens CustomerEmailToken[]
  customerAddresses CustomerAddress[]
  storeCreditEntries StoreCreditEntry[]
  storeCreditReservations StoreCreditReservation[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @db.Char(64)
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model MenuCategory {
  id        String    @id @default(cuid())
  nameFr    String
  nameEn              String
  fulfillmentCategory FulfillmentCategory @default(OTHER)
  position            Int       @default(0)
  products            Product[]
}

model Product {
  id         String       @id @default(cuid())
  categoryId String
  nameFr     String
  nameEn     String
  active     Boolean      @default(true)
  baseCents  Int
  ingredients String[] @default([])
  removableIngredients String[] @default([])
  catalogRevision Int @default(0)
  choiceLabel String?
  extraSelectionMode ExtraSelectionMode @default(MULTIPLE)
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  sizes      ProductSize[]
  extras     ProductExtra[]
  @@index([categoryId, active])
}

model Order {
  id               String          @id @default(cuid())
  publicReference  String          @unique
  userId           String?
  guestEmail       String?         @db.VarChar(320)
  fulfillment      FulfillmentType
  status           OrderStatus     @default(PENDING)
  paymentStatus    OrderPaymentStatus @default(PENDING)
  requestKey       String?         @unique @db.VarChar(64)
  requestHash      String?         @db.Char(64)
  contactName      String?         @db.VarChar(128)
  phone            String?         @db.VarChar(40)
  address          String?         @db.VarChar(300)
  zoneId           String?
  scheduledFor     DateTime?
  pizzaCount       Int             @default(0)
  comment          String?         @db.VarChar(500)
  stripeSessionId  String?         @unique
  stripePaymentIntentId String?    @unique
  itemsSnapshot    Json?
  revision         Int             @default(0)
  printedAt        DateTime?
  totalCents       Int
  subtotalCents    Int             @default(0)
  discountCents    Int             @default(0)
  loyaltyDiscountCents Int         @default(0)
  loyaltyPaidDishCount Int          @default(0)
  loyaltyFreeDishCount Int          @default(0)
  promotionId      String?
  promotionName    String?         @db.VarChar(100)
  creditAppliedCents Int @default(0)
  currency         String          @default("EUR") @db.Char(3)
  placedAt         DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  storeCreditEntries StoreCreditEntry[]
  storeCreditReservation StoreCreditReservation?
  promotion        Promotion?      @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  @@index([status, placedAt])
  @@index([userId, placedAt])
  @@index([paymentStatus, status, placedAt])
  @@index([scheduledFor, status])
}

model StripeWebhookEvent {
  id        String   @id
  type      String   @db.VarChar(120)
  createdAt DateTime @default(now())
}

enum StoreCreditEntryKind {
  MANAGER_GRANT
  ORDER_REDEMPTION
  ORDER_REFUND
}

enum StoreCreditReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

model StoreCreditEntry {
  id String @id @default(cuid())
  userId String
  orderId String?
  kind StoreCreditEntryKind
  amountCents Int
  note String? @db.VarChar(240)
  consentConfirmedAt DateTime?
  consentConfirmedBy String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  @@unique([orderId, kind])
  @@index([userId, createdAt])
}

model StoreCreditReservation {
  id String @id @default(cuid())
  userId String
  orderId String @unique
  amountCents Int
  status StoreCreditReservationStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([userId, status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  nameSnapshot   String
  quantity       Int
  unitPriceCents Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model ProductSize {
  id         String  @id @default(cuid())
  productId  String
  label      String
  priceCents Int
  active     Boolean @default(true)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, label])
}

model ProductExtra {
  sizePrices Json?
  id         String  @id @default(cuid())
  productId  String
  nameFr     String
  nameEn     String
  priceCents Int
  active     Boolean @default(true)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, active])
}

model Ingredient {
  id String @id @default(cuid())
  nameFr String @unique @db.VarChar(128)
  nameEn String @db.VarChar(128)
  price33Cents Int @default(150)
  price50Cents Int @default(300)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ManagerAccessToken {
  tokenHash String @id @db.Char(64)
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model CustomerCredential {
  version Int @default(0)
  userId String @id
  passwordHash String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthThrottle {
  key String @id @db.Char(64)
  attempts Int @default(0)
  windowStart DateTime @default(now())
}

model TestOrder {
  id String @id @default(cuid())
  publicReference String @unique
  userId String
  requestKey String @db.VarChar(64)
  requestHash String @db.Char(64)
  fulfillment FulfillmentType
  zoneId String?
  scheduledFor DateTime @default(now())
  pizzaCount Int @default(0)
  contactName String @db.VarChar(128)
  phone String @db.VarChar(40)
  address String? @db.VarChar(300)
  comment String? @db.VarChar(500)
  status OrderStatus @default(PENDING)
  revision Int @default(0)
  subtotalCents Int @default(0)
  discountCents Int @default(0)
  loyaltyDiscountCents Int @default(0)
  loyaltyPaidDishCount Int @default(0)
  loyaltyFreeDishCount Int @default(0)
  totalCents Int
  promotionId String?
  promotionCode String?
  promotionName String?
  itemsSnapshot Json
  placedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  @@unique([userId, requestKey])
  @@index([userId, placedAt])
  @@index([userId, status])
  @@index([status, placedAt])
}

model Promotion {
  id String @id @default(cuid())
  name String @db.VarChar(100)
  kind PromotionKind
  code String? @unique @db.VarChar(32)
  discountType PromotionDiscountType
  value Int
  minimumSubtotalCents Int @default(0)
  validFrom DateTime? @db.Date
  validUntil DateTime? @db.Date
  weekdays Int[] @default([1, 2, 3, 4, 5, 6, 7])
  startTime String? @db.VarChar(5)
  endTime String? @db.VarChar(5)
  usageLimit Int?
  usageCount Int @default(0)
  active Boolean @default(false)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  testOrders TestOrder[]
  orders Order[]
  firstOrderOnly Boolean @default(false)
  @@index([kind, active, validFrom, validUntil])
}

model DeliveryConfiguration {
  id String @id @default("global")
  leadTimeMinutes Int @default(30)
  slotPizzaCapacity Int @default(7)
  revision Int @default(0)
  updatedAt DateTime @updatedAt
}

model HomePageContent {
  id String @id @default("global")
  eyebrow String @default("PIZZERIA ROMA · NAMUR") @db.VarChar(80)
  title String @default("De véritables saveurs italiennes à Namur") @db.VarChar(180)
  intro String @default("Pizzas artisanales, pâtes, salades et bien plus encore. À emporter ou en livraison, toujours avec passion.") @db.VarChar(500)
  primaryLabel String @default("Découvrir la carte") @db.VarChar(60)
  secondaryLabel String @default("Voir la carte") @db.VarChar(60)
  heroImage String @default("/roma-hero.png") @db.VarChar(300)
  aboutTitle String @default("Une histoire de famille, de passion et de tradition") @db.VarChar(180)
  aboutTextOne String @default("Présente dans le Namurois depuis 2003, la Pizzeria Roma cultive une ambiance familiale et le goût des traditions culinaires italiennes.") @db.VarChar(500)
  aboutTextTwo String @default("Livraison, plats à emporter et recettes préparées avec soin : découvrez l’histoire qui nous lie à nos clients depuis plus de vingt ans.") @db.VarChar(500)
  metaTitle String @default("Pizza italienne à Namur depuis 2003") @db.VarChar(70)
  metaDescription String @default("Découvrez les pizzas, pâtes et spécialités de Pizzeria Roma à Namur. À emporter ou en livraison.") @db.VarChar(170)
  revision Int @default(0)
  updatedAt DateTime @updatedAt
}

model DeliveryZoneBoundary {
  zoneId String @id
  geometry Json
  revision Int @default(0)
  updatedAt DateTime @updatedAt
}

enum CustomerEmailPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

model CustomerEmailToken {
  tokenHash String @id @db.Char(64)
  userId String
  email String @db.VarChar(320)
  purpose CustomerEmailPurpose
  credentialVersion Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
  @@index([expiresAt])
}

model CustomerAddress {
  id String @id @default(cuid())
  userId String
  label String @db.VarChar(60)
  address String @db.VarChar(300)
  zoneId String
  isDefault Boolean @default(false)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  // The migration also enforces one default per owner with a partial unique index.
}
