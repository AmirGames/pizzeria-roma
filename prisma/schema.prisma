generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MANAGER
  KITCHEN
}

enum FulfillmentCategory {
  PIZZA
  PASTA
  OTHER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  REJECTED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum ExtraSelectionMode {
  MULTIPLE
  SINGLE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(320)
  name          String?   @db.VarChar(160)
  phone         String?   @db.VarChar(40)
  emailVerified DateTime?
  role          UserRole  @default(CUSTOMER)
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  sessions      Session[]
  managerAccessTokens ManagerAccessToken[]
  customerCredential CustomerCredential?
  testOrders TestOrder[]
  customerEmailTokens CustomerEmailToken[]
  customerAddresses CustomerAddress[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @db.Char(64)
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model MenuCategory {
  id        String    @id @default(cuid())
  nameFr    String
  nameEn              String
  fulfillmentCategory FulfillmentCategory @default(OTHER)
  position            Int       @default(0)
  products            Product[]
}

model Product {
  id         String       @id @default(cuid())
  categoryId String
  nameFr     String
  nameEn     String
  active     Boolean      @default(true)
  baseCents  Int
  removableIngredients String[] @default([])
  catalogRevision Int @default(0)
  choiceLabel String?
  extraSelectionMode ExtraSelectionMode @default(MULTIPLE)
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  sizes      ProductSize[]
  extras     ProductExtra[]
  @@index([categoryId, active])
}

model Order {
  id               String          @id @default(cuid())
  publicReference  String          @unique
  userId           String?
  guestEmail       String?         @db.VarChar(320)
  fulfillment      FulfillmentType
  status           OrderStatus     @default(PENDING)
  totalCents       Int
  currency         String          @default("EUR") @db.Char(3)
  placedAt         DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  @@index([status, placedAt])
  @@index([userId, placedAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  nameSnapshot   String
  quantity       Int
  unitPriceCents Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model ProductSize {
  id         String  @id @default(cuid())
  productId  String
  label      String
  priceCents Int
  active     Boolean @default(true)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, label])
}

model ProductExtra {
  sizePrices Json?
  id         String  @id @default(cuid())
  productId  String
  nameFr     String
  nameEn     String
  priceCents Int
  active     Boolean @default(true)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, active])
}

model ManagerAccessToken {
  tokenHash String @id @db.Char(64)
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model CustomerCredential {
  version Int @default(0)
  userId String @id
  passwordHash String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthThrottle {
  key String @id @db.Char(64)
  attempts Int @default(0)
  windowStart DateTime @default(now())
}

model TestOrder {
  id String @id @default(cuid())
  publicReference String @unique
  userId String
  requestKey String @db.VarChar(64)
  requestHash String @db.Char(64)
  fulfillment FulfillmentType
  zoneId String?
  scheduledFor DateTime @default(now())
  pizzaCount Int @default(0)
  contactName String @db.VarChar(128)
  phone String @db.VarChar(40)
  address String? @db.VarChar(300)
  comment String? @db.VarChar(500)
  status OrderStatus @default(PENDING)
  revision Int @default(0)
  totalCents Int
  itemsSnapshot Json
  placedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, requestKey])
  @@index([userId, placedAt])
  @@index([status, placedAt])
}

model DeliveryConfiguration {
  id String @id @default("global")
  pickupLeadMinutes Int @default(30)
  slotPizzaCapacity Int @default(7)
  revision Int @default(0)
  updatedAt DateTime @updatedAt
}

model DeliveryZoneBoundary {
  zoneId String @id
  geometry Json
  revision Int @default(0)
  updatedAt DateTime @updatedAt
}

enum CustomerEmailPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model CustomerEmailToken {
  tokenHash String @id @db.Char(64)
  userId String
  email String @db.VarChar(320)
  purpose CustomerEmailPurpose
  credentialVersion Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
  @@index([expiresAt])
}

model CustomerAddress {
  id String @id @default(cuid())
  userId String
  label String @db.VarChar(60)
  address String @db.VarChar(300)
  zoneId String
  isDefault Boolean @default(false)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  // The migration also enforces one default per owner with a partial unique index.
}
