# Local development only. Never commit real credentials.
# DATABASE_URL=postgresql://roma:<password>@localhost:5432/roma?schema=public
# POSTGRES_PASSWORD=<set-a-strong-local-password>

# Public origin for manager requests behind a reverse proxy (no trailing path).
# APP_ORIGIN=https://votre-site.be

# Local customer accounts and simulated orders only (disabled by default).
# ENABLE_TEST_ORDERS=true

# Mailpit captures customer verification and recovery messages locally.
# LOCAL_MAIL_URL=http://127.0.0.1:8025
