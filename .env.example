# Local development only. Never commit real credentials.
# DATABASE_URL=postgresql://roma:<password>@localhost:5432/roma?schema=public
# POSTGRES_PASSWORD=<set-a-strong-local-password>
# Optional host port when 5432 is unavailable (also update DATABASE_URL).
# POSTGRES_PORT=5433

# Public origin for manager requests behind a reverse proxy (no trailing path).
# APP_ORIGIN=https://votre-site.be

# Optional: HTML verification token from Google Search Console.
# GOOGLE_SITE_VERIFICATION=

# Local customer accounts and simulated orders only (disabled by default).
# ENABLE_TEST_ORDERS=true

# Mailpit captures customer verification and recovery messages locally.
# LOCAL_MAIL_URL=http://127.0.0.1:8025

# Stripe hosted Checkout. Use test-mode credentials during setup; never commit keys.
# ENABLE_REAL_ORDERS=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_ORIGIN=https://votre-site.be
# A live secret key is rejected unless this separate switch is explicitly enabled.
# ENABLE_LIVE_PAYMENTS=false

# Contact and customer-account email delivery via Resend in real mode. Use a verified sender domain.
# RESEND_API_KEY=re_...
# CONTACT_EMAIL=restaurant@example.be
# CONTACT_FROM_EMAIL=Pizzeria Roma <contact@votre-domaine.be>
